+static int mspm0_queue_reg(struct adiv5_ap *ap, uint32_t addr, uint32_t value)
+{
+	struct adiv5_dap *dap = ap->dap;
+	int retval;
+
+	retval = dap_queue_ap_write(ap, MEM_AP_REG_TAR(dap), addr);
+	if (retval == ERROR_OK)
+		retval = dap_queue_ap_write(ap, MEM_AP_REG_DRW(dap), value);
+	return retval;
+}
+
+static int mspm0_queue_regs(struct adiv5_ap *ap, uint32_t addr,
+		const uint32_t *values, unsigned int count)
+{
+	struct adiv5_dap *dap = ap->dap;
+	int retval;
+
+	retval = dap_queue_ap_write(ap, MEM_AP_REG_TAR(dap), addr);
+	for (unsigned int i = 0; i < count && retval == ERROR_OK; i++)
+		retval = dap_queue_ap_write(ap, MEM_AP_REG_DRW(dap), values[i]);
+	return retval;
+}

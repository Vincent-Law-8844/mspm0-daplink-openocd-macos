+/*
+ * Program one MSPM0 flash word.  The command registers are queued as a single
+ * DAP transfer instead of one USB round-trip per register; with a HID CMSIS-DAP
+ * probe this is the difference between ~16 ms and a few ms per 8-byte word.
+ */
+static int mspm0_program_word(struct flash_bank *bank, unsigned int addr,
+		const unsigned char *buffer, unsigned int num_bytes,
+		unsigned int protect_reg, uint32_t protect_mask,
+		bool write_cmdtype, bool write_byteen, uint32_t *status)
+{
+	struct cortex_m_common *cortex_m = target_to_cm(bank->target);
+	struct adiv5_ap *ap = cortex_m->armv7m.debug_ap;
+	uint32_t data0 = 0;
+	uint32_t data1 = 0;
+	uint32_t bytes_en;
+	int retval;
+
+	if (!ap) {
+		LOG_ERROR("MSPM0 flash write: no MEM-AP");
+		return ERROR_FAIL;
+	}
+
+	for (unsigned int i = 0; i < num_bytes && i < 4; i++)
+		data0 |= (uint32_t)buffer[i] << (8 * i);
+	for (unsigned int i = 4; i < num_bytes; i++)
+		data1 |= (uint32_t)buffer[i] << (8 * (i - 4));
+
+	bytes_en = (1u << num_bytes) - 1;
+	bytes_en |= BIT(8);	/* ECC chunk for one 64-bit flash word */
+
+	if (write_cmdtype)
+		retval = mspm0_queue_reg(ap, FCTL_REG_CMDTYPE,
+				FCTL_CMDTYPE_COMMAND_PROGRAM | FCTL_CMDTYPE_SIZE_ONEWORD);
+	else
+		retval = ERROR_OK;
+	if (retval == ERROR_OK && write_byteen) {
+		uint32_t addr_bytes[2] = { addr, bytes_en };
+		retval = mspm0_queue_regs(ap, FCTL_REG_CMDADDR, addr_bytes, 2);
+	}
+	if (retval == ERROR_OK)
+		retval = mspm0_queue_reg(ap, protect_reg, ~protect_mask);
+	if (retval == ERROR_OK) {
+		uint32_t data[2] = { data0, data1 };
+		retval = mspm0_queue_regs(ap, FCTL_REG_CMDDATA0, data,
+				num_bytes > 4 ? 2 : 1);
+	}
+	if (retval == ERROR_OK)
+		retval = mspm0_queue_reg(ap, FCTL_REG_CMDEXEC, FCTL_CMDEXEC_VAL_EXECUTE);
+	if (retval == ERROR_OK && status) {
+		struct adiv5_dap *dap = ap->dap;
+		retval = dap_queue_ap_write(ap, MEM_AP_REG_TAR(dap), FCTL_REG_STATCMD);
+		if (retval == ERROR_OK)
+			retval = dap_queue_ap_read(ap, MEM_AP_REG_DRW(dap), status);
+	}
+	if (retval == ERROR_OK)
+		retval = dap_run(ap->dap);
+
+	return retval;
+}
